[
  { "id": "greetings-01", "category": "Greetings", "context": "Morning", "english": "Good morning (polite)", "japanese": "おはようございます", "romaji": "Ohayou gozaimasu" },
  { "id": "greetings-02", "category": "Greetings", "context": "Morning · casual", "english": "Morning!", "japanese": "おはよう", "romaji": "Ohayou" },
  { "id": "greetings-03", "category": "Greetings", "english": "Hello / Good afternoon", "japanese": "こんにちは", "romaji": "Konnichiwa" },
  { "id": "greetings-04", "category": "Greetings", "context": "Evening", "english": "Good evening", "japanese": "こんばんは", "romaji": "Konbanwa" },
  { "id": "greetings-05", "category": "Greetings", "context": "First meeting only", "english": "Nice to meet you", "japanese": "はじめまして", "romaji": "Hajimemashite" },
  { "id": "greetings-06", "category": "Greetings", "context": "After introducing yourself", "english": "Please treat me well / I look forward to working with you", "japanese": "よろしくお願いします", "romaji": "Yoroshiku onegaishimasu" },
  { "id": "greetings-07", "category": "Greetings", "english": "Thank you (polite)", "japanese": "ありがとうございます", "romaji": "Arigatou gozaimasu" },
  { "id": "greetings-08", "category": "Greetings", "english": "Excuse me / I'm sorry / Thank you", "japanese": "すみません", "romaji": "Sumimasen" },
  { "id": "greetings-09", "category": "Greetings", "english": "I am intruding (entering home)", "japanese": "お邪魔します", "romaji": "O-jama shimasu" },
  { "id": "greetings-10", "category": "Greetings", "context": "Casual · friends", "english": "Hi!", "japanese": "やあ", "romaji": "Yaa" },
  { "id": "greetings-11", "category": "Greetings", "context": "Casual · friends", "english": "Hey!", "japanese": "よー", "romaji": "Yoo" },
  { "id": "greetings-12", "category": "Greetings", "context": "Casual · friends", "english": "Hey! (mostly men)", "japanese": "おっす", "romaji": "Ossu" },
  { "id": "greetings-13", "category": "Greetings", "context": "Casual · friends", "english": "Long time no see", "japanese": "ひさしぶり", "romaji": "Hisashiburi" },
  { "id": "greetings-14", "category": "Greetings", "context": "Phone only", "english": "Hello? (on the phone)", "japanese": "もしもし", "romaji": "Moshi moshi" },
  { "id": "greetings-15", "category": "Greetings", "context": "Heard from shop staff", "english": "Welcome (to our store)", "japanese": "いらっしゃいませ", "romaji": "Irasshaimase" },
  { "id": "greetings-16", "category": "Greetings", "context": "Goodbye · formal", "english": "Goodbye", "japanese": "さようなら", "romaji": "Sayounara" },
  { "id": "greetings-17", "category": "Greetings", "context": "Goodbye · casual", "english": "See you", "japanese": "じゃあね", "romaji": "Jaa ne" },
  { "id": "greetings-18", "category": "Greetings", "context": "Goodbye · casual", "english": "See you again", "japanese": "またね", "romaji": "Mata ne" },

  { "id": "learning-01", "category": "Learning", "context": "Yes & no", "english": "Yes", "japanese": "はい", "romaji": "Hai" },
  { "id": "learning-02", "category": "Learning", "context": "Yes & no", "english": "No", "japanese": "いいえ", "romaji": "Iie" },
  { "id": "learning-03", "category": "Learning", "context": "Yes & no · casual", "english": "Yeah", "japanese": "うん", "romaji": "Un" },
  { "id": "learning-04", "category": "Learning", "context": "Yes & no · casual", "english": "Nah", "japanese": "ううん", "romaji": "Uun" },
  { "id": "learning-05", "category": "Learning", "english": "I'm sorry, I don't speak Japanese.", "japanese": "すみません、日本語が話せません。", "romaji": "Sumimasen, Nihongo ga hanasemasen." },
  { "id": "learning-06", "category": "Learning", "english": "I don't understand.", "japanese": "わかりません。", "romaji": "Wakarimasen." },
  { "id": "learning-07", "category": "Learning", "english": "I understand.", "japanese": "わかりました。", "romaji": "Wakarimashita." },
  { "id": "learning-08", "category": "Learning", "english": "Could you please repeat that?", "japanese": "もう一度言っていただけますか？", "romaji": "Mou ichido itte itadakemasu ka?" },
  { "id": "learning-09", "category": "Learning", "english": "Could you speak a little slower, please?", "japanese": "もう少しゆっくり話していただけますか？", "romaji": "Mou sukoshi yukkuri hanashite itadakemasu ka?" },
  { "id": "learning-10", "category": "Learning", "english": "Could you write it down, please?", "japanese": "書いていただけますか？", "romaji": "Kaite itadakemasu ka?" },
  { "id": "learning-11", "category": "Learning", "english": "What is this?", "japanese": "これは何ですか？", "romaji": "Kore wa nan desu ka?" },
  { "id": "learning-12", "category": "Learning", "english": "How do you say ... in Japanese?", "japanese": "...は日本語で何と言いますか？", "romaji": "... wa Nihongo de nan to iimasu ka?" },
  { "id": "learning-13", "category": "Learning", "english": "What does ... mean?", "japanese": "...はどういう意味ですか？", "romaji": "... wa dou iu imi desu ka?" },

  { "id": "transport-01", "category": "Transport", "english": "Where is the train station?", "japanese": "駅はどこですか？", "romaji": "Eki wa doko desu ka?" },
  { "id": "transport-02", "category": "Transport", "english": "Does this train stop at...?", "japanese": "この電車は...に止まりますか？", "romaji": "Kono densha wa... ni tomarimasu ka?" },
  { "id": "transport-03", "category": "Transport", "english": "How much is the ticket?", "japanese": "切符はいくらですか？", "romaji": "Kippu wa ikura desu ka?" },
  { "id": "transport-04", "category": "Transport", "context": "Buying tickets", "english": "Where is the ticket machine?", "japanese": "券売機はどこですか？", "romaji": "Kenbaiki wa doko desu ka?" },
  { "id": "transport-05", "category": "Transport", "context": "Directions", "english": "Which platform is for Osaka?", "japanese": "大阪行きは何番線ですか？", "romaji": "Osaka yuki wa nan-bansen desu ka?" },
  { "id": "transport-06", "category": "Transport", "context": "Flight changes", "english": "My flight was canceled.", "japanese": "フライトがキャンセルされました。", "romaji": "Furaito ga kyanseru saremashita." },
  { "id": "transport-07", "category": "Transport", "context": "Lost luggage", "english": "My baggage hasn't arrived.", "japanese": "荷物が届きません。", "romaji": "Nimotsu ga todokimasen." },
  { "id": "transport-08", "category": "Transport", "context": "Word", "english": "Station", "japanese": "駅", "romaji": "Eki" },
  { "id": "transport-09", "category": "Transport", "context": "Word", "english": "Ticket", "japanese": "切符", "romaji": "Kippu" },
  { "id": "transport-10", "category": "Transport", "context": "Word", "english": "Airport", "japanese": "空港", "romaji": "Kuukou" },
  { "id": "transport-11", "category": "Transport", "context": "Word", "english": "Luggage", "japanese": "荷物", "romaji": "Nimotsu" },

  { "id": "dining-01", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Getting the staff's attention", "english": "Excuse me!", "japanese": "すみません！", "romaji": "Sumimasen!", "tip": "Raise a hand a little and say it loudly. Calling out for service isn't rude here — it's expected, even in a quiet izakaya." },
  { "id": "dining-02", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Icebreaker", "english": "What do you recommend?", "japanese": "おすすめは何ですか？", "romaji": "Osusume wa nan desu ka?", "tip": "Ask it at the counter, not just your server. Staff and the regulars next to you love answering, and it opens the door to a conversation." },
  { "id": "dining-03", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Toast", "english": "Cheers!", "japanese": "乾杯！", "romaji": "Kanpai!", "tip": "Lock eyes with someone at the counter, raise your glass a little, and smile. It's the easiest way to strike up a conversation with a stranger." },
  { "id": "dining-04", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Compliment", "english": "This is really good, isn't it!", "japanese": "これ、めっちゃ美味しいですね！", "romaji": "Kore, meccha oishii desu ne!", "tip": "Meccha is casual slang for \"super / really.\" Saying this to the chef or the person next to you breaks the ice fast." },
  { "id": "dining-05", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Reservations", "english": "Do you have a table for two?", "japanese": "2名ですが、入れますか？", "romaji": "Ni-mei desu ga, hairemasu ka?" },
  { "id": "dining-06", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Menu", "english": "Do you have an English menu?", "japanese": "英語のメニューはありますか？", "romaji": "Eigo no menyuu wa arimasu ka?" },
  { "id": "dining-07", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Dietary needs", "english": "I am vegetarian.", "japanese": "私はベジタリアンです。", "romaji": "Watashi wa bejitarian desu." },
  { "id": "dining-08", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Ordering", "english": "I'll have this.", "japanese": "これをお願いします。", "romaji": "Kore o onegaishimasu.", "tip": "Point at the menu or a neighbor's dish as you say it. Swap \"kore\" (this) for any item name once you know it." },
  { "id": "dining-09", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Refills", "english": "Water, please.", "japanese": "お水、お願いします", "romaji": "O-mizu, onegai shimasu", "tip": "Water is free almost everywhere in Japan, but if your glass runs dry, this gets a refill fast." },
  { "id": "dining-10", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Leaving", "english": "Thank you for the meal, it was a feast!", "japanese": "ごちそうさまでした！", "romaji": "Gochisousama deshita!", "tip": "Say it out loud on your way out. It earns real respect from the chef and staff, and turns you from a tourist into a regular." },
  { "id": "dining-11", "category": "Dining", "group": "Cafés & Convenience Stores (Konbini)", "context": "Ordering", "english": "To go, please.", "japanese": "テイクアウトでお願いします", "romaji": "Teikuauto de onegai shimasu", "tip": "For dine-in instead, say Ten'nai de (店内で)." },
  { "id": "dining-12", "category": "Dining", "group": "Cafés & Convenience Stores (Konbini)", "context": "Declining", "english": "I'm okay, thanks.", "japanese": "大丈夫です", "romaji": "Daijoubu desu", "tip": "Konbini clerks often ask if you want a bag or your food heated up. A small wave of the hand plus this phrase politely says no thanks." },
  { "id": "dining-13", "category": "Dining", "group": "Getting the Bill (Everywhere)", "context": "Asking for it", "english": "Check, please", "japanese": "お会計をお願いします", "romaji": "Okaikei o onegaishimasu", "tip": "In a loud izakaya, cross your index fingers into an \"X\" toward the server instead — it's the universal Japanese hand signal for \"check, please.\"" },
  { "id": "dining-14", "category": "Dining", "group": "Getting the Bill (Everywhere)", "context": "Splitting the bill", "english": "Separate checks, please.", "japanese": "別々でお会計をお願いします。", "romaji": "Betsubetsu de okaikei o onegaishimasu." },
  { "id": "dining-15", "category": "Dining", "context": "Word", "english": "The check", "japanese": "お会計", "romaji": "Okaikei" },
  { "id": "dining-16", "category": "Dining", "context": "Word", "english": "Menu", "japanese": "メニュー", "romaji": "Menyuu" },
