  { "id": "accommodation-01", "category": "Accommodation", "context": "Check-in", "english": "Can I leave my luggage here?", "japanese": "荷物を預かってもらえますか？", "romaji": "Nimotsu o azukatte moraemasu ka?" },
  { "id": "accommodation-02", "category": "Accommodation", "context": "Room issues", "english": "The air conditioner is broken.", "japanese": "エアコンが壊れています。", "romaji": "Eakon ga kowarete imasu." },
  { "id": "accommodation-03", "category": "Accommodation", "context": "Checkout", "english": "Could you call a taxi?", "japanese": "タクシーを呼んでもらえますか？", "romaji": "Takushii o yonde moraemasu ka?" },
  { "id": "accommodation-04", "category": "Accommodation", "context": "Word", "english": "Front desk", "japanese": "フロント", "romaji": "Furonto" },
