  { "id": "dining-20", "category": "Dining", "context": "Word", "english": "Meal / cooked rice", "japanese": "ごはん", "romaji": "Gohan" },
  { "id": "dining-21", "category": "Dining", "context": "Word", "english": "Meat", "japanese": "肉", "romaji": "Niku" },
