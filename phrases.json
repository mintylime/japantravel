[
  {"id": "greetings-01", "category": "Essentials", "context": "Morning", "english": "Good morning (polite)", "japanese": "おはようございます", "romaji": "Ohayou gozaimasu", "say": "oh-hah-yoh go-zai-mass", "tip": "Until about 10am."},
  {"id": "greetings-02", "category": "Essentials", "context": "Morning · casual", "english": "Morning!", "japanese": "おはよう", "romaji": "Ohayou"},
  {"id": "greetings-03", "category": "Essentials", "english": "Hello / Good afternoon", "japanese": "こんにちは", "romaji": "Konnichiwa", "say": "kon-nee-chee-wah", "tip": "Also the greeting on hiking trails."},
  {"id": "greetings-04", "category": "Essentials", "context": "Evening", "english": "Good evening", "japanese": "こんばんは", "romaji": "Konbanwa", "say": "kon-bahn-wah"},
  {"id": "greetings-05", "category": "Essentials", "context": "First meeting only", "english": "Nice to meet you", "japanese": "はじめまして", "romaji": "Hajimemashite", "say": "hah-jee-meh-mash-teh"},
  {"id": "greetings-06", "category": "Essentials", "context": "After introducing yourself", "english": "Please treat me well / I look forward to working with you", "japanese": "よろしくお願いします", "romaji": "Yoroshiku onegaishimasu", "say": "yoh-roh-shkoo oh-neh-guy shee-mass"},
  {"id": "greetings-07", "category": "Essentials", "english": "Thank you (polite)", "japanese": "ありがとうございます", "romaji": "Arigatou gozaimasu", "say": "ah-ree-gah-toh go-zai-mass"},
  {"id": "greetings-08", "category": "Essentials", "english": "Excuse me / I'm sorry / Thank you", "japanese": "すみません", "romaji": "Sumimasen"},
  {"id": "greetings-09", "category": "Essentials", "english": "I am intruding (entering home)", "japanese": "お邪魔します", "romaji": "O-jama shimasu", "say": "oh-jah-mah shee-mass"},
  {"id": "greetings-10", "category": "Essentials", "context": "Casual · friends", "english": "Hi!", "japanese": "やあ", "romaji": "Yaa"},
  {"id": "greetings-11", "category": "Essentials", "context": "Casual · friends", "english": "Hey!", "japanese": "よー", "romaji": "Yoo"},
  {"id": "greetings-12", "category": "Essentials", "context": "Casual · friends", "english": "Hey! (mostly men)", "japanese": "おっす", "romaji": "Ossu"},
  {"id": "greetings-13", "category": "Essentials", "context": "Casual · friends", "english": "Long time no see", "japanese": "ひさしぶり", "romaji": "Hisashiburi"},
  {"id": "greetings-14", "category": "Essentials", "context": "Phone only", "english": "Hello? (on the phone)", "japanese": "もしもし", "romaji": "Moshi moshi"},
  {"id": "greetings-15", "category": "Essentials", "context": "Heard from shop staff", "english": "Welcome (to our store)", "japanese": "いらっしゃいませ", "romaji": "Irasshaimase"},
  {"id": "greetings-16", "category": "Essentials", "context": "Goodbye · formal", "english": "Goodbye", "japanese": "さようなら", "romaji": "Sayounara"},
  {"id": "greetings-17", "category": "Essentials", "context": "Goodbye · casual", "english": "See you", "japanese": "じゃあね", "romaji": "Jaa ne"},
  {"id": "greetings-18", "category": "Essentials", "context": "Goodbye · casual", "english": "See you again", "japanese": "またね", "romaji": "Mata ne"},
  {"id": "essentials-01", "category": "Essentials", "english": "Thank you (for what you did)", "japanese": "ありがとうございました", "romaji": "arigatō gozaimashita", "say": "ah-ree-gah-toh go-zai-mash-tah", "tip": "Past tense. Use it leaving a shop or after a favour."},
  {"id": "essentials-02", "category": "Essentials", "english": "Excuse me / sorry / thanks for the trouble", "japanese": "すみません", "romaji": "sumimasen", "say": "soo-mee-mah-sen", "tip": "Your most useful word. Calls staff, squeezes past, apologises."},
  {"id": "essentials-03", "category": "Essentials", "english": "Please, go ahead", "japanese": "どうぞ", "romaji": "dōzo", "say": "doh-zoh", "tip": "Offering a seat or letting someone go first."},
  {"id": "essentials-04", "category": "Essentials", "english": "Please (asking)", "japanese": "お願いします", "romaji": "onegai shimasu", "say": "oh-neh-guy shee-mass", "tip": "Point at something and say this."},
  {"id": "essentials-05", "category": "Essentials", "english": "I'm fine / no thanks", "japanese": "大丈夫です", "romaji": "daijōbu desu", "say": "dai-joh-boo dess", "tip": "The polite way to turn down a bag, help or an offer."},
  {"id": "essentials-06", "category": "Essentials", "english": "Yes / No", "japanese": "はい / いいえ", "romaji": "hai / iie", "say": "high / ee-eh", "tip": "\"Hai\" often means \"I'm listening,\" not \"I agree.\""},
  {"id": "essentials-07", "category": "Essentials", "english": "I don't understand Japanese", "japanese": "日本語がわかりません", "romaji": "nihongo ga wakarimasen", "say": "nee-hon-go gah wah-kah-ree-mah-sen"},
  {"id": "essentials-08", "category": "Essentials", "english": "I speak a little Japanese", "japanese": "日本語、少しだけ話せます", "romaji": "nihongo, sukoshi dake hanasemasu", "say": "nee-hon-go, skoh-shee dah-keh hah-nah-seh-mass", "tip": "Lowers the pressure for both of you."},
  {"id": "essentials-09", "category": "Essentials", "english": "Once more, please", "japanese": "もう一度お願いします", "romaji": "mō ichido onegai shimasu", "say": "moh ee-chee-doh oh-neh-guy shee-mass"},
  {"id": "essentials-10", "category": "Essentials", "english": "Slowly, please", "japanese": "ゆっくりお願いします", "romaji": "yukkuri onegai shimasu", "say": "yook-koo-ree oh-neh-guy shee-mass"},
  {"id": "essentials-11", "category": "Essentials", "english": "It's beautiful", "japanese": "きれいですね", "romaji": "kirei desu ne", "say": "kee-ray dess neh"},
  {"id": "learning-01", "category": "Learning", "context": "Yes & no", "english": "Yes", "japanese": "はい", "romaji": "Hai"},
  {"id": "learning-02", "category": "Learning", "context": "Yes & no", "english": "No", "japanese": "いいえ", "romaji": "Iie"},
  {"id": "learning-03", "category": "Learning", "context": "Yes & no · casual", "english": "Yeah", "japanese": "うん", "romaji": "Un"},
  {"id": "learning-04", "category": "Learning", "context": "Yes & no · casual", "english": "Nah", "japanese": "ううん", "romaji": "Uun"},
  {"id": "learning-05", "category": "Learning", "english": "I'm sorry, I don't speak Japanese.", "japanese": "すみません、日本語が話せません。", "romaji": "Sumimasen, Nihongo ga hanasemasen."},
  {"id": "learning-06", "category": "Learning", "english": "I don't understand.", "japanese": "わかりません。", "romaji": "Wakarimasen."},
  {"id": "learning-07", "category": "Learning", "english": "I understand.", "japanese": "わかりました。", "romaji": "Wakarimashita."},
  {"id": "learning-08", "category": "Learning", "english": "Could you please repeat that?", "japanese": "もう一度言っていただけますか？", "romaji": "Mou ichido itte itadakemasu ka?"},
  {"id": "learning-09", "category": "Learning", "english": "Could you speak a little slower, please?", "japanese": "もう少しゆっくり話していただけますか？", "romaji": "Mou sukoshi yukkuri hanashite itadakemasu ka?"},
  {"id": "learning-10", "category": "Learning", "english": "Could you write it down, please?", "japanese": "書いていただけますか？", "romaji": "Kaite itadakemasu ka?"},
  {"id": "learning-11", "category": "Learning", "english": "What is this?", "japanese": "これは何ですか？", "romaji": "Kore wa nan desu ka?"},
  {"id": "learning-12", "category": "Learning", "english": "How do you say ... in Japanese?", "japanese": "...は日本語で何と言いますか？", "romaji": "... wa Nihongo de nan to iimasu ka?"},
  {"id": "learning-13", "category": "Learning", "english": "What does ... mean?", "japanese": "...はどういう意味ですか？", "romaji": "... wa dou iu imi desu ka?"},
  {"id": "connecting-01", "category": "Connecting", "english": "It's my first time in Japan", "japanese": "日本は初めてです", "romaji": "Nihon wa hajimete desu", "say": "nee-hon wah hah-jee-meh-teh dess", "tip": "Locals love hearing it. Expect recommendations."},
  {"id": "connecting-02", "category": "Connecting", "english": "I'm from Australia", "japanese": "オーストラリアから来ました", "romaji": "Ōsutoraria kara kimashita", "say": "oh-soo-toh-rah-ree-ah kah-rah kee-mash-tah", "tip": "Other countries are in the Builder tab."},
  {"id": "connecting-03", "category": "Connecting", "english": "Is this spot OK?", "japanese": "ここ、いいですか？", "romaji": "koko, ii desu ka?", "say": "koh-koh ee dess kah", "tip": "At a standing bar or shared table."},
  {"id": "connecting-04", "category": "Connecting", "english": "The same as that, please", "japanese": "同じものをください", "romaji": "onaji mono o kudasai", "say": "oh-nah-jee moh-noh oh koo-dah-sigh", "tip": "Point at your neighbour's drink. Instant conversation."},
  {"id": "connecting-05", "category": "Connecting", "english": "Where do locals go?", "japanese": "地元の人はどこに行きますか？", "romaji": "jimoto no hito wa doko ni ikimasu ka?", "say": "jee-moh-toh noh hee-toh wah doh-koh nee ee-kee-mass kah", "tip": "Best question for bar staff and innkeepers."},
  {"id": "connecting-06", "category": "Connecting", "english": "What's the local speciality?", "japanese": "名物は何ですか？", "romaji": "meibutsu wa nan desu ka?", "say": "may-boo-tsoo wah nahn dess kah"},
  {"id": "connecting-07", "category": "Connecting", "english": "How long has this shop been going?", "japanese": "創業何年ですか？", "romaji": "sōgyō nannen desu ka?", "say": "soh-gyoh nahn-nen dess kah", "tip": "Owners of old shops are proud of the answer."},
  {"id": "connecting-08", "category": "Connecting", "english": "I love Osaka", "japanese": "大阪、めっちゃ好きです", "romaji": "Ōsaka, meccha suki desu", "say": "oh-sah-kah, metch-ah skee dess", "tip": "Half Kansai-ben. Guaranteed grin."},
  {"id": "connecting-09", "category": "Connecting", "english": "Amazing skill", "japanese": "すごい技ですね", "romaji": "sugoi waza desu ne", "say": "soo-goy wah-zah dess neh", "tip": "For craftspeople, chefs, anyone making something."},
  {"id": "connecting-10", "category": "Connecting", "english": "May I take your photo?", "japanese": "写真を撮ってもいいですか？", "romaji": "shashin o tottemo ii desu ka?", "say": "shah-sheen oh tot-teh-moh ee dess kah", "tip": "Always ask before photographing people."},
  {"id": "connecting-11", "category": "Connecting", "english": "Cheers!", "japanese": "乾杯！", "romaji": "kanpai!", "say": "kahn-pie"},
  {"id": "connecting-12", "category": "Connecting", "english": "Take care!", "japanese": "お元気で", "romaji": "ogenki de", "say": "oh-gen-kee deh", "tip": "A warm goodbye to someone you won't see again. You'll hear it a lot on the Kumano Kodo."},
  {"id": "dining-01", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Getting the staff's attention", "english": "Excuse me!", "japanese": "すみません！", "romaji": "Sumimasen!", "tip": "Raise a hand a little and say it loudly. Calling out for service isn't rude here — it's expected, even in a quiet izakaya."},
  {"id": "dining-02", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Icebreaker", "english": "What do you recommend?", "japanese": "おすすめは何ですか？", "romaji": "Osusume wa nan desu ka?", "say": "oh-soo-soo-meh wah nahn dess kah", "tip": "Ask it at the counter, not just your server. Staff and the regulars next to you love answering, and it opens the door to a conversation."},
  {"id": "dining-03", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Toast", "english": "Cheers!", "japanese": "乾杯！", "romaji": "Kanpai!", "tip": "Lock eyes with someone at the counter, raise your glass a little, and smile. It's the easiest way to strike up a conversation with a stranger."},
  {"id": "dining-04", "category": "Dining", "group": "Izakaya & Counter Bars", "context": "Compliment", "english": "This is really good, isn't it!", "japanese": "これ、めっちゃ美味しいですね！", "romaji": "Kore, meccha oishii desu ne!", "tip": "Meccha is casual slang for \"super / really.\" Saying this to the chef or the person next to you breaks the ice fast."},
  {"id": "dining-05", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Reservations", "english": "Do you have a table for two?", "japanese": "2名ですが、入れますか？", "romaji": "Ni-mei desu ga, hairemasu ka?"},
  {"id": "dining-06", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Menu", "english": "Do you have an English menu?", "japanese": "英語のメニューはありますか？", "romaji": "Eigo no menyuu wa arimasu ka?", "say": "ay-go noh meh-nyoo wah ah-ree-mass kah"},
  {"id": "dining-07", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Dietary needs", "english": "I am vegetarian.", "japanese": "私はベジタリアンです。", "romaji": "Watashi wa bejitarian desu."},
  {"id": "dining-08", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Ordering", "english": "I'll have this.", "japanese": "これをお願いします。", "romaji": "Kore o onegaishimasu.", "tip": "Point at the menu or a neighbor's dish as you say it. Swap \"kore\" (this) for any item name once you know it."},
  {"id": "dining-09", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Refills", "english": "Water, please.", "japanese": "お水、お願いします", "romaji": "O-mizu, onegai shimasu", "tip": "Water is free almost everywhere in Japan, but if your glass runs dry, this gets a refill fast."},
  {"id": "dining-10", "category": "Dining", "group": "Casual Restaurants & Ramen Shops", "context": "Leaving", "english": "Thank you for the meal, it was a feast!", "japanese": "ごちそうさまでした！", "romaji": "Gochisousama deshita!", "say": "go-chee-soh-sah-mah desh-tah", "tip": "Say it out loud on your way out. It earns real respect from the chef and staff, and turns you from a tourist into a regular."},
  {"id": "dining-27", "category": "Dining", "group": "What's on the Menu", "context": "Rice bowl", "english": "Chicken and egg gently simmered together in a sweet soy broth, served over a bowl of rice.", "japanese": "親子丼", "romaji": "Oyakodon"},
  {"id": "dining-28", "category": "Dining", "group": "What's on the Menu", "context": "Rice bowl", "english": "A breaded, deep-fried pork cutlet simmered with egg and onion, served over rice.", "japanese": "カツ丼", "romaji": "Katsudon"},
  {"id": "dining-29", "category": "Dining", "group": "What's on the Menu", "context": "Rice bowl", "english": "Thin slices of beef and onion simmered in a sweet, savory soy sauce, served over rice.", "japanese": "牛丼", "romaji": "Gyuudon"},
  {"id": "dining-30", "category": "Dining", "group": "What's on the Menu", "context": "Rice bowl", "english": "A thick, mild Japanese-style curry sauce poured over rice, usually with meat and vegetables.", "japanese": "カレーライス", "romaji": "Karee raisu"},
  {"id": "dining-31", "category": "Dining", "group": "What's on the Menu", "context": "Rice bowl", "english": "Battered, deep-fried shrimp and vegetables served over rice and drizzled with a sweet soy sauce.", "japanese": "天丼", "romaji": "Tendon"},
  {"id": "dining-32", "category": "Dining", "group": "What's on the Menu", "context": "Rice bowl · raw", "english": "An assortment of fresh raw seafood arranged over a bowl of vinegared rice.", "japanese": "海鮮丼", "romaji": "Kaisendon"},
  {"id": "dining-33", "category": "Dining", "group": "What's on the Menu", "context": "Raw", "english": "Bite-sized mounds of vinegared rice, each topped with a slice of raw or cooked fish or seafood.", "japanese": "寿司", "romaji": "Sushi"},
  {"id": "dining-34", "category": "Dining", "group": "What's on the Menu", "context": "Raw", "english": "Fresh raw fish or seafood, thinly sliced and served on its own, without rice.", "japanese": "刺身", "romaji": "Sashimi", "tip": "Not the same as sushi — no rice. Dip it lightly in soy sauce; a little goes a long way."},
  {"id": "dining-35", "category": "Dining", "group": "What's on the Menu", "context": "Noodles", "english": "Ramen noodles in a clear, savory broth seasoned with soy sauce.", "japanese": "醤油ラーメン", "romaji": "Shouyu raamen"},
  {"id": "dining-36", "category": "Dining", "group": "What's on the Menu", "context": "Noodles", "english": "Ramen noodles in a hearty broth flavored with fermented soybean paste.", "japanese": "味噌ラーメン", "romaji": "Miso raamen"},
  {"id": "dining-37", "category": "Dining", "group": "What's on the Menu", "context": "Noodles", "english": "Ramen noodles in a rich, cloudy broth made by simmering pork bones for hours until creamy.", "japanese": "豚骨ラーメン", "romaji": "Tonkotsu raamen"},
  {"id": "dining-38", "category": "Dining", "group": "What's on the Menu", "context": "Noodles", "english": "Thick, chewy wheat noodles, usually served in a light, savory soy broth.", "japanese": "うどん", "romaji": "Udon"},
  {"id": "dining-39", "category": "Dining", "group": "What's on the Menu", "context": "Noodles", "english": "Thin buckwheat noodles, served hot in broth or cold on a tray with a dipping sauce.", "japanese": "そば", "romaji": "Soba"},
  {"id": "dining-40", "category": "Dining", "group": "What's on the Menu", "context": "Noodles", "english": "Noodles stir-fried with vegetables and meat in a sweet, tangy sauce.", "japanese": "焼きそば", "romaji": "Yakisoba"},
  {"id": "dining-41", "category": "Dining", "group": "What's on the Menu", "context": "Fried & grilled", "english": "Bite-sized pieces of chicken, marinated in soy and ginger, then deep-fried until crisp.", "japanese": "唐揚げ", "romaji": "Karaage"},
  {"id": "dining-42", "category": "Dining", "group": "What's on the Menu", "context": "Fried & grilled", "english": "A pork cutlet, breaded in panko and deep-fried, usually sliced and served with shredded cabbage.", "japanese": "とんかつ", "romaji": "Tonkatsu"},
  {"id": "dining-43", "category": "Dining", "group": "What's on the Menu", "context": "Fried & grilled", "english": "Bite-sized pieces of chicken, skewered and grilled over charcoal, often brushed with a sweet soy glaze.", "japanese": "焼き鳥", "romaji": "Yakitori"},
  {"id": "dining-44", "category": "Dining", "group": "What's on the Menu", "context": "Fried & grilled", "english": "Seafood or vegetables dipped in a light batter and deep-fried until crisp — not heavy or greasy.", "japanese": "天ぷら", "romaji": "Tenpura"},
  {"id": "dining-45", "category": "Dining", "group": "What's on the Menu", "context": "Fried & grilled", "english": "A savory pancake of batter, shredded cabbage and your choice of meat or seafood, grilled and topped with sauce, mayonnaise and bonito flakes.", "japanese": "お好み焼き", "romaji": "Okonomiyaki"},
  {"id": "dining-46", "category": "Dining", "group": "What's on the Menu", "context": "Fried & grilled", "english": "Ball-shaped batter snacks with a piece of octopus inside, grilled until crisp outside and molten in the middle.", "japanese": "たこ焼き", "romaji": "Takoyaki"},
  {"id": "dining-47", "category": "Dining", "group": "What's on the Menu", "context": "Fried & grilled", "english": "Dumplings filled with minced pork and vegetables, pan-fried crisp on one side and steamed on the other.", "japanese": "餃子", "romaji": "Gyouza"},
  {"id": "dining-48", "category": "Dining", "group": "What's on the Menu", "context": "Soup & hot pot", "english": "A light broth made from fermented soybean paste, usually with tofu and a little seaweed or green onion.", "japanese": "味噌汁", "romaji": "Miso shiru"},
  {"id": "dining-49", "category": "Dining", "group": "What's on the Menu", "context": "Soup & hot pot", "english": "A pot of meat, seafood and vegetables simmered together in broth right at the table, shared family-style.", "japanese": "鍋", "romaji": "Nabe"},
  {"id": "dining-50", "category": "Dining", "group": "What's on the Menu", "context": "Snack", "english": "A hand-shaped ball of rice, often wrapped in a sheet of seaweed, with a savory filling tucked in the middle.", "japanese": "おにぎり", "romaji": "Onigiri"},
  {"id": "dining-11", "category": "Dining", "group": "Cafés & Convenience Stores (Konbini)", "context": "Ordering", "english": "To go, please.", "japanese": "テイクアウトでお願いします", "romaji": "Teikuauto de onegai shimasu", "tip": "For dine-in instead, say Ten'nai de (店内で)."},
  {"id": "dining-12", "category": "Dining", "group": "Cafés & Convenience Stores (Konbini)", "context": "Declining", "english": "I'm okay, thanks.", "japanese": "大丈夫です", "romaji": "Daijoubu desu", "tip": "Konbini clerks often ask if you want a bag or your food heated up. A small wave of the hand plus this phrase politely says no thanks."},
  {"id": "dining-13", "category": "Dining", "group": "Getting the Bill (Everywhere)", "context": "Asking for it", "english": "Check, please", "japanese": "お会計をお願いします", "romaji": "Okaikei o onegaishimasu", "tip": "In a loud izakaya, cross your index fingers into an \"X\" toward the server instead — it's the universal Japanese hand signal for \"check, please.\""},
  {"id": "dining-14", "category": "Dining", "group": "Getting the Bill (Everywhere)", "context": "Splitting the bill", "english": "Separate checks, please.", "japanese": "別々でお会計をお願いします。", "romaji": "Betsubetsu de okaikei o onegaishimasu."},
  {"id": "dining-15", "category": "Dining", "context": "Word", "english": "The check", "japanese": "お会計", "romaji": "Okaikei"},
  {"id": "dining-16", "category": "Dining", "context": "Word", "english": "Menu", "japanese": "メニュー", "romaji": "Menyuu"},
  {"id": "dining-17", "category": "Dining", "context": "Word", "english": "Reservation", "japanese": "予約", "romaji": "Yoyaku"},
  {"id": "dining-18", "category": "Dining", "context": "Word", "english": "Allergy", "japanese": "アレルギー", "romaji": "Arerugii"},
  {"id": "dining-19", "category": "Dining", "context": "Word", "english": "Water", "japanese": "水", "romaji": "Mizu"},
  {"id": "dining-20", "category": "Dining", "context": "Word", "english": "Meal / cooked rice", "japanese": "ごはん", "romaji": "Gohan"},
  {"id": "dining-21", "category": "Dining", "context": "Word", "english": "Meat", "japanese": "肉", "romaji": "Niku"},
  {"id": "dining-22", "category": "Dining", "context": "Word", "english": "Fish", "japanese": "魚", "romaji": "Sakana"},
  {"id": "dining-23", "category": "Dining", "context": "Word", "english": "Seafood", "japanese": "魚介類", "romaji": "Gyokairui"},
  {"id": "dining-24", "category": "Dining", "context": "Word", "english": "Seafood (on menus)", "japanese": "海鮮", "romaji": "Kaisen"},
  {"id": "dining-25", "category": "Dining", "context": "Word", "english": "Vegetables", "japanese": "野菜", "romaji": "Yasai"},
  {"id": "dining-26", "category": "Dining", "context": "Word", "english": "Fruit", "japanese": "果物", "romaji": "Kudamono"},
  {"id": "dining-51", "category": "Dining", "group": "Anywhere You Eat", "english": "Two people", "japanese": "二人です", "romaji": "futari desu", "say": "foo-tah-ree dess", "tip": "Hold up two fingers too."},
  {"id": "dining-52", "category": "Dining", "group": "Anywhere You Eat", "english": "One person", "japanese": "一人です", "romaji": "hitori desu", "say": "hee-toh-ree dess", "tip": "Ask for the counter. Best seat for a solo traveller."},
  {"id": "dining-53", "category": "Dining", "group": "Anywhere You Eat", "english": "Before eating", "japanese": "いただきます", "romaji": "itadakimasu", "say": "ee-tah-dah-kee-mass"},
  {"id": "dining-54", "category": "Dining", "group": "Anywhere You Eat", "english": "Delicious", "japanese": "美味しい！", "romaji": "oishii!", "say": "oy-shee", "tip": "Works anywhere."},
  {"id": "dining-55", "category": "Dining", "group": "Anywhere You Eat", "english": "Tasty! (casual)", "japanese": "うまい！", "romaji": "umai!", "say": "oo-my", "tip": "Punchy and a bit blokey. Great at a counter; oishii is safer somewhere smart."},
  {"id": "dining-56", "category": "Dining", "group": "Anywhere You Eat", "english": "This one, please", "japanese": "これをください", "romaji": "kore o kudasai", "say": "koh-reh oh koo-dah-sigh"},
  {"id": "dining-57", "category": "Dining", "group": "Anywhere You Eat", "english": "A draft beer, please", "japanese": "生ビールをください", "romaji": "nama biiru o kudasai", "say": "nah-mah bee-roo oh koo-dah-sigh"},
  {"id": "dining-59", "category": "Dining", "group": "Anywhere You Eat", "english": "The bill, please", "japanese": "お会計お願いします", "romaji": "o-kaikei onegai shimasu", "say": "oh-kai-kay oh-neh-guy shee-mass", "tip": "Or cross your index fingers. Pay at the front."},
  {"id": "dining-60", "category": "Dining", "group": "Anywhere You Eat", "english": "Is there fish in the dashi?", "japanese": "出汁に魚は入っていますか？", "romaji": "dashi ni sakana wa haitte imasu ka?", "say": "dah-shee nee sah-kah-nah wah hite-teh ee-mass kah", "tip": "Fish stock is in almost everything."},
  {"id": "dining-61", "category": "Dining", "group": "Anywhere You Eat", "english": "I have an allergy", "japanese": "アレルギーがあります", "romaji": "arerugī ga arimasu", "say": "ah-reh-roo-gee gah ah-ree-mass", "tip": "Then use the Builder: \"I cannot eat…\""},
  {"id": "shopping-19", "category": "Shopping", "group": "In a Store (Asking Staff)", "context": "Do they stock it? (natural)", "english": "Do you carry / stock [item]?", "japanese": "...って置いてますか？", "romaji": "... tte oitemasu ka?", "tip": "Native speakers rarely ask if a store \"sells\" (uru) something. They ask if it's stocked (oite iru) — this is the most natural way to ask. って (tte) is the casual spoken way to introduce the item."},
  {"id": "shopping-20", "category": "Shopping", "group": "In a Store (Asking Staff)", "context": "Do they have it? (simple & casual)", "english": "Do you have [item]?", "japanese": "...ありますか？", "romaji": "... arimasu ka?", "tip": "The easiest version to remember — works for almost anything, a little more casual than って置いてますか."},
  {"id": "shopping-06", "category": "Shopping", "group": "In a Store (Asking Staff)", "context": "Where is it? (direct & polite)", "english": "Where is the [item]?", "japanese": "...はどこですか？", "romaji": "... wa doko desu ka?"},
  {"id": "shopping-21", "category": "Shopping", "group": "In a Store (Asking Staff)", "context": "Where, roughly? (conversational)", "english": "Around where would [item] be?", "japanese": "...ってどのへんにありますか？", "romaji": "... tte dono hen ni arimasu ka?", "tip": "どのへん (dono hen) means \"around where\" / \"which general area\" — softer and more conversational than the flat どこですか. Good when a staff member is about to walk you toward the aisle. E.g. 折りたたみの踏み台ってどのへんにありますか？ (\"around where would a folding step stool be?\")."},
  {"id": "shopping-07", "category": "Shopping", "group": "In a Store (Asking Staff)", "context": "Show, don't tell", "english": "I'm looking for this. (show a picture)", "japanese": "これを探しています", "romaji": "Kore o sagashite imasu"},
  {"id": "shopping-08", "category": "Shopping", "group": "In a Store (Asking Staff)", "context": "Asking for help", "english": "Could you help me, please?", "japanese": "手伝っていただけますか？", "romaji": "Tetsudatte itadakemasu ka?"},
  {"id": "shopping-22", "category": "Shopping", "group": "On the Street (Asking Where to Buy)", "context": "Asking a local, not staff", "english": "Where around here can I buy [item]?", "japanese": "このへんで、...ってどこで買えますか？", "romaji": "Kono hen de, ... tte doko de kaemasu ka?", "tip": "このへんで (kono hen de) = \"around here.\" 買えますか (kaemasu ka) = \"can I buy?\" — the standard way to ask a local, a hotel clerk, or a stranger on the street for a store that carries something, rather than asking staff who are already in front of you."},
  {"id": "shopping-09", "category": "Shopping", "group": "Trying Things On (Clothes)", "context": "Clothes", "english": "May I try it on?", "japanese": "試着してもいいですか？", "romaji": "Shichaku shite mo ii desu ka?"},
  {"id": "shopping-10", "category": "Shopping", "group": "Trying Things On (Clothes)", "context": "Clothes", "english": "Do you have another size?", "japanese": "ほかのサイズはありますか？", "romaji": "Hoka no saizu wa arimasu ka?"},
  {"id": "shopping-11", "category": "Shopping", "group": "Trying Things On (Clothes)", "context": "Clothes", "english": "Do you have other colors?", "japanese": "ほかの色はありますか？", "romaji": "Hoka no iro wa arimasu ka?"},
  {"id": "shopping-01", "category": "Shopping", "group": "Paying & Money", "english": "How much is this?", "japanese": "これはいくらですか？", "romaji": "Kore wa ikura desu ka?", "say": "koh-reh wah ee-koo-rah dess kah"},
  {"id": "shopping-13", "category": "Shopping", "group": "Paying & Money", "english": "How much is it in total?", "japanese": "全部でいくらですか？", "romaji": "Zenbu de ikura desu ka?"},
  {"id": "shopping-02", "category": "Shopping", "group": "Paying & Money", "context": "Bargaining", "english": "Can you make it a little cheaper?", "japanese": "もう少し安くなりますか？", "romaji": "Mou sukoshi yasukunarimasu ka?"},
  {"id": "shopping-12", "category": "Shopping", "group": "Paying & Money", "english": "I'll take this, please.", "japanese": "これをください", "romaji": "Kore o kudasai"},
  {"id": "shopping-03", "category": "Shopping", "group": "Paying & Money", "english": "Do you take credit cards?", "japanese": "クレジットカードは使えますか？", "romaji": "Kurejitto kaado wa tsukaemasu ka?"},
  {"id": "shopping-04", "category": "Shopping", "group": "Paying & Money", "context": "Payments", "english": "Can I use Apple Pay?", "japanese": "アップルペイは使えますか？", "romaji": "Appuru pei wa tsukaemasu ka?"},
  {"id": "shopping-14", "category": "Shopping", "group": "Paying & Money", "context": "Payments", "english": "Can I pay with cash?", "japanese": "現金でもいいですか？", "romaji": "Genkin demo ii desu ka?"},
  {"id": "shopping-05", "category": "Shopping", "group": "Paying & Money", "context": "Exchanging", "english": "Where can I exchange money?", "japanese": "両替はどこでできますか？", "romaji": "Ryougae wa doko de dekimasu ka?"},
  {"id": "shopping-15", "category": "Shopping", "context": "Word", "english": "Cash", "japanese": "現金", "romaji": "Genkin"},
  {"id": "shopping-16", "category": "Shopping", "context": "Word", "english": "Credit card", "japanese": "クレジットカード", "romaji": "Kurejitto kaado"},
  {"id": "shopping-17", "category": "Shopping", "context": "Word", "english": "Money exchange", "japanese": "両替", "romaji": "Ryougae"},
  {"id": "shopping-18", "category": "Shopping", "context": "Word", "english": "Cash register", "japanese": "レジ", "romaji": "Reji"},
  {"id": "shopping-23", "category": "Shopping", "group": "Markets & Craft Shops", "english": "Can I pay by card?", "japanese": "カードは使えますか？", "romaji": "kādo wa tsukaemasu ka?", "say": "kah-doh wah tsoo-kah-eh-mass kah", "tip": "Temples, stalls and bathhouses are often cash only."},
  {"id": "shopping-24", "category": "Shopping", "group": "Markets & Craft Shops", "english": "Is this handmade?", "japanese": "手作りですか？", "romaji": "tezukuri desu ka?", "say": "teh-zoo-koo-ree dess kah"},
  {"id": "shopping-25", "category": "Shopping", "group": "Markets & Craft Shops", "english": "No nails are used?", "japanese": "釘は使っていないんですか？", "romaji": "kugi wa tsukatte inain desu ka?", "say": "koo-gee wah tsoo-kaht-teh ee-nine dess kah", "tip": "Joinery makers light up at this."},
  {"id": "shopping-26", "category": "Shopping", "group": "Markets & Craft Shops", "english": "I'll take this", "japanese": "これにします", "romaji": "kore ni shimasu", "say": "koh-reh nee shee-mass"},
  {"id": "shopping-27", "category": "Shopping", "group": "Markets & Craft Shops", "english": "No bag, thanks", "japanese": "袋は大丈夫です", "romaji": "fukuro wa daijōbu desu", "say": "foo-koo-roh wah dai-joh-boo dess"},
  {"id": "transport-01", "category": "Transport", "english": "Where is the train station?", "japanese": "駅はどこですか？", "romaji": "Eki wa doko desu ka?", "say": "eh-kee wah doh-koh dess kah"},
  {"id": "transport-02", "category": "Transport", "english": "Does this train stop at...?", "japanese": "この電車は...に止まりますか？", "romaji": "Kono densha wa... ni tomarimasu ka?"},
  {"id": "transport-03", "category": "Transport", "english": "How much is the ticket?", "japanese": "切符はいくらですか？", "romaji": "Kippu wa ikura desu ka?"},
  {"id": "transport-04", "category": "Transport", "context": "Buying tickets", "english": "Where is the ticket machine?", "japanese": "券売機はどこですか？", "romaji": "Kenbaiki wa doko desu ka?"},
  {"id": "transport-05", "category": "Transport", "context": "Directions", "english": "Which platform is for Osaka?", "japanese": "大阪行きは何番線ですか？", "romaji": "Osaka yuki wa nan-bansen desu ka?"},
  {"id": "transport-06", "category": "Transport", "context": "Flight changes", "english": "My flight was canceled.", "japanese": "フライトがキャンセルされました。", "romaji": "Furaito ga kyanseru saremashita."},
  {"id": "transport-07", "category": "Transport", "context": "Lost luggage", "english": "My baggage hasn't arrived.", "japanese": "荷物が届きません。", "romaji": "Nimotsu ga todokimasen."},
  {"id": "transport-08", "category": "Transport", "context": "Word", "english": "Station", "japanese": "駅", "romaji": "Eki"},
  {"id": "transport-09", "category": "Transport", "context": "Word", "english": "Ticket", "japanese": "切符", "romaji": "Kippu"},
  {"id": "transport-10", "category": "Transport", "context": "Word", "english": "Airport", "japanese": "空港", "romaji": "Kuukou"},
  {"id": "transport-11", "category": "Transport", "context": "Word", "english": "Luggage", "japanese": "荷物", "romaji": "Nimotsu"},
  {"id": "transport-12", "category": "Transport", "english": "One ticket to Kōyasan, please", "japanese": "高野山まで一枚お願いします", "romaji": "Kōyasan made ichimai onegai shimasu", "say": "koh-yah-sahn mah-deh ee-chee-my oh-neh-guy shee-mass", "tip": "Swap in any place name."},
  {"id": "transport-13", "category": "Transport", "english": "Does this train stop at Umeda?", "japanese": "この電車は梅田に止まりますか？", "romaji": "kono densha wa Umeda ni tomarimasu ka?", "say": "koh-noh den-shah wah oo-meh-dah nee toh-mah-ree-mass kah", "tip": "Rapid and express trains skip stations. The Builder has more places."},
  {"id": "transport-14", "category": "Transport", "english": "Where's the bus stop for Arima Onsen?", "japanese": "有馬温泉行きのバス停はどこですか？", "romaji": "Arima onsen iki no basutei wa doko desu ka?", "say": "ah-ree-mah on-sen ee-kee noh bah-soo-tay wah doh-koh dess kah"},
  {"id": "transport-15", "category": "Transport", "english": "I'd like to go here (show map)", "japanese": "ここに行きたいです", "romaji": "koko ni ikitai desu", "say": "koh-koh nee ee-kee-tai dess"},
  {"id": "transport-16", "category": "Transport", "english": "Where's the toilet?", "japanese": "お手洗いはどこですか？", "romaji": "otearai wa doko desu ka?", "say": "oh-teh-ah-rai wah doh-koh dess kah"},
  {"id": "accommodation-01", "category": "Accommodation", "context": "Check-in", "english": "Can I leave my luggage here?", "japanese": "荷物を預かってもらえますか？", "romaji": "Nimotsu o azukatte moraemasu ka?"},
  {"id": "accommodation-02", "category": "Accommodation", "context": "Room issues", "english": "The air conditioner is broken.", "japanese": "エアコンが壊れています。", "romaji": "Eakon ga kowarete imasu."},
  {"id": "accommodation-03", "category": "Accommodation", "context": "Checkout", "english": "Could you call a taxi?", "japanese": "タクシーを呼んでもらえますか？", "romaji": "Takushii o yonde moraemasu ka?"},
  {"id": "accommodation-04", "category": "Accommodation", "context": "Word", "english": "Front desk", "japanese": "フロント", "romaji": "Furonto"},
  {"id": "accommodation-05", "category": "Accommodation", "context": "Word", "english": "Room", "japanese": "部屋", "romaji": "Heya"},
  {"id": "accommodation-06", "category": "Accommodation", "context": "Word", "english": "Key", "japanese": "鍵", "romaji": "Kagi"},
  {"id": "accommodation-07", "category": "Accommodation", "context": "Word", "english": "Taxi", "japanese": "タクシー", "romaji": "Takushii"},
  {"id": "homes-01", "category": "Homes", "english": "Thanks for having me (leaving)", "japanese": "お邪魔しました", "romaji": "o-jama shimashita", "say": "oh-jah-mah shee-mash-tah"},
  {"id": "homes-02", "category": "Homes", "english": "A little something (handing a gift)", "japanese": "つまらないものですが", "romaji": "tsumaranai mono desu ga", "say": "tsoo-mah-rah-nai moh-noh dess gah", "tip": "Formal and humble. \"Kore, dōzo\" works too."},
  {"id": "homes-03", "category": "Homes", "english": "Thank you for everything", "japanese": "いろいろありがとうございました", "romaji": "iroiro arigatō gozaimashita", "say": "ee-roh-ee-roh ah-ree-gah-toh go-zai-mash-tah"},
  {"id": "temples-01", "category": "Temples & Shrines", "english": "A seal (goshuin), please", "japanese": "御朱印をお願いします", "romaji": "goshuin o onegai shimasu", "say": "go-shoo-een oh oh-neh-guy shee-mass", "tip": "Devotional, ¥300–500. Use a proper book."},
  {"id": "temples-02", "category": "Temples & Shrines", "english": "May I go inside?", "japanese": "中に入ってもいいですか？", "romaji": "naka ni haitte mo ii desu ka?", "say": "nah-kah nee hite-teh moh ee dess kah"},
  {"id": "temples-03", "category": "Temples & Shrines", "english": "Should I take off my shoes?", "japanese": "靴を脱ぎますか？", "romaji": "kutsu o nugimasu ka?", "say": "koo-tsoo oh noo-gee-mass kah"},
  {"id": "temples-04", "category": "Temples & Shrines", "english": "May I take photos here?", "japanese": "ここで写真を撮ってもいいですか？", "romaji": "koko de shashin o tottemo ii desu ka?", "say": "koh-koh deh shah-sheen oh tot-teh-moh ee dess kah"},
  {"id": "temples-05", "category": "Temples & Shrines", "english": "Can I join the morning service?", "japanese": "朝のお勤めに参加できますか？", "romaji": "asa no otsutome ni sanka dekimasu ka?", "say": "ah-sah noh oh-tsoo-toh-meh nee sahn-kah deh-kee-mass kah", "tip": "For your Kōyasan temple stay."},
  {"id": "temples-06", "category": "Temples & Shrines", "english": "The temple food was delicious", "japanese": "精進料理、とても美味しかったです", "romaji": "shōjin ryōri, totemo oishikatta desu", "say": "shoh-jeen ryoh-ree, toh-teh-moh oy-shee-kaht-tah dess"},
  {"id": "onsen-01", "category": "Onsen & Sentō", "english": "Are tattoos OK?", "japanese": "タトゥーは大丈夫ですか？", "romaji": "tatū wa daijōbu desu ka?", "say": "tah-too wah dai-joh-boo dess kah"},
  {"id": "onsen-02", "category": "Onsen & Sentō", "english": "Is there a private bath?", "japanese": "貸切風呂はありますか？", "romaji": "kashikiri-buro wa arimasu ka?", "say": "kah-shee-kee-ree boo-roh wah ah-ree-mass kah"},
  {"id": "onsen-03", "category": "Onsen & Sentō", "english": "Can I rent a towel?", "japanese": "タオルを借りられますか？", "romaji": "taoru o kariraremasu ka?", "say": "tah-oh-roo oh kah-ree-rah-reh-mass kah"},
  {"id": "onsen-04", "category": "Onsen & Sentō", "english": "The water's hot, isn't it", "japanese": "お湯、熱いですね", "romaji": "o-yu, atsui desu ne", "say": "oh-yoo, ah-tsoo-ee dess neh", "tip": "Easy small talk with the grandpa next to you."},
  {"id": "onsen-05", "category": "Onsen & Sentō", "english": "That feels great", "japanese": "気持ちいい", "romaji": "kimochi ii", "say": "kee-moh-chee ee"},
  {"id": "onsen-06", "category": "Onsen & Sentō", "english": "Please show me how to wear the yukata", "japanese": "浴衣の着方を教えてください", "romaji": "yukata no kikata o oshiete kudasai", "say": "yoo-kah-tah noh kee-kah-tah oh oh-shee-eh-teh koo-dah-sigh", "tip": "Left side over right. Always."},
  {"id": "hiking-01", "category": "Hiking", "english": "Is this path open?", "japanese": "この道は通れますか？", "romaji": "kono michi wa tōremasu ka?", "say": "koh-noh mee-chee wah toh-reh-mass kah"},
  {"id": "hiking-02", "category": "Hiking", "english": "How many minutes to the top?", "japanese": "頂上まで何分ですか？", "romaji": "chōjō made nanpun desu ka?", "say": "choh-joh mah-deh nahn-poon dess kah"},
  {"id": "hiking-03", "category": "Hiking", "english": "How long on foot?", "japanese": "歩いて何分ですか？", "romaji": "aruite nanpun desu ka?", "say": "ah-roo-ee-teh nahn-poon dess kah"},
  {"id": "hiking-04", "category": "Hiking", "english": "Are there bears?", "japanese": "熊は出ますか？", "romaji": "kuma wa demasu ka?", "say": "koo-mah wah deh-mass kah", "tip": "Bears have been seen near Rokko. Carry a bell."},
  {"id": "hiking-05", "category": "Hiking", "english": "What time is the last bus?", "japanese": "最終バスは何時ですか？", "romaji": "saishū basu wa nanji desu ka?", "say": "sai-shoo bah-soo wah nahn-jee dess kah", "tip": "Rural buses stop early. Ask before you set off."},
  {"id": "hiking-06", "category": "Hiking", "english": "I'm lost", "japanese": "道に迷いました", "romaji": "michi ni mayoimashita", "say": "mee-chee nee mah-yoy-mash-tah"},
  {"id": "hiking-07", "category": "Hiking", "english": "I'm on the Kumano pilgrimage", "japanese": "熊野詣です", "romaji": "Kumano mōde desu", "say": "koo-mah-noh moh-deh dess"},
  {"id": "kansai-ben-01", "category": "Kansai-ben", "english": "Thanks (the merchant's thank-you)", "japanese": "おおきに", "romaji": "ōkini", "say": "oh-kee-nee", "tip": "Charming with shopkeepers and older vendors. Try \"ōkini, oishikatta!\" as you pay."},
  {"id": "kansai-ben-02", "category": "Kansai-ben", "english": "Very / super", "japanese": "めっちゃ", "romaji": "meccha", "say": "metch-ah", "tip": "\"Meccha oishii!\" = super tasty."},
  {"id": "kansai-ben-03", "category": "Kansai-ben", "english": "Really?", "japanese": "ほんま？", "romaji": "honma?", "say": "hohn-mah", "tip": "\"Honma ni ōkini\" = thanks so much."},
  {"id": "kansai-ben-04", "category": "Kansai-ben", "english": "No good / hopeless", "japanese": "あかん", "romaji": "akan", "say": "ah-kahn", "tip": "Fine for jokes about yourself. Don't use it to turn down a host."},
  {"id": "kansai-ben-05", "category": "Kansai-ben", "english": "How much?", "japanese": "なんぼ？", "romaji": "nanbo?", "say": "nahn-boh", "tip": "\"Kore nanbo?\" at a market stall. Too cheeky for a department store."},
  {"id": "kansai-ben-06", "category": "Kansai-ben", "english": "Hi / thanks (to regulars)", "japanese": "まいど", "romaji": "maido", "say": "my-doh", "tip": "You'll hear it from shop staff. Say it back once you're a regular."},
  {"id": "kansai-ben-07", "category": "Kansai-ben", "english": "Nice vibe", "japanese": "ええ感じ！", "romaji": "ee kanji!", "say": "eh-eh kahn-jee", "tip": "\"Ee\" is Kansai for good."},
  {"id": "kansai-ben-08", "category": "Kansai-ben", "english": "I don't get it", "japanese": "わからへん", "romaji": "wakarahen", "say": "wah-kah-rah-hen", "tip": "Kansai version of wakarimasen."},
  {"id": "kansai-ben-09", "category": "Kansai-ben", "english": "Why on earth?!", "japanese": "なんでやねん", "romaji": "nande ya nen", "say": "nahn-deh yah nen", "tip": "The comedy retort. Only with friends who are already joking. From a visitor, it brings the house down."},
  {"id": "kansai-ben-10", "category": "Kansai-ben", "english": "Exhausted", "japanese": "しんどい", "romaji": "shindoi", "say": "sheen-doy", "tip": "Perfect after a Rokko hike."},
  {"id": "kansai-ben-11", "category": "Kansai-ben", "english": "Making money?", "japanese": "儲かりまっか？", "romaji": "mōkarimakka?", "say": "moh-kah-ree-mahk-kah", "tip": "The old merchant greeting. Mostly a joke now."},
  {"id": "kansai-ben-12", "category": "Kansai-ben", "english": "So-so", "japanese": "ぼちぼちでんな", "romaji": "bochi-bochi denna", "say": "boh-chee boh-chee den-nah", "tip": "The traditional reply. \"Bochi-bochi\" alone works when asked how you are."},
  {"id": "kobe-01", "category": "Kobe", "english": "Do you have the Kobe beef certificate?", "japanese": "神戸ビーフの証明書はありますか？", "romaji": "Kōbe bīfu no shōmeisho wa arimasu ka?", "say": "koh-beh bee-foo noh shoh-may-sho wah ah-ree-mass kah", "tip": "\"Wagyu\" signs can mean other beef. Certified places can show a 10-digit ID."},
  {"id": "kobe-02", "category": "Kobe", "english": "Sirloin / tenderloin, please", "japanese": "サーロイン / ヒレでお願いします", "romaji": "sāroin / hire de onegai shimasu", "say": "sah-roh-een / hee-reh deh oh-neh-guy shee-mass", "tip": "For teppanyaki."},
  {"id": "kobe-03", "category": "Kobe", "english": "A dry sake, please", "japanese": "辛口のお酒をください", "romaji": "karakuchi no osake o kudasai", "say": "kah-rah-koo-chee noh oh-sah-keh oh koo-dah-sigh", "tip": "Nada sake is dry by tradition."},
  {"id": "kobe-04", "category": "Kobe", "english": "Which way is the mountain side?", "japanese": "山側はどっちですか？", "romaji": "yama-gawa wa dotchi desu ka?", "say": "yah-mah-gah-wah wah dot-chee dess kah", "tip": "Kobe directions: mountain side is north, sea side (umi-gawa) south."},
  {"id": "kobe-05", "category": "Kobe", "english": "What're you up to?", "japanese": "何しとん？", "romaji": "nani shiton?", "say": "nah-nee shee-tohn", "tip": "Kobe-ben, casual. Friends only."},
  {"id": "kobe-06", "category": "Kobe", "english": "Two pork buns, please", "japanese": "豚まん二つください", "romaji": "butaman futatsu kudasai", "say": "boo-tah-mahn foo-tah-tsoo koo-dah-sigh", "tip": "Nankinmachi."},
  {"id": "kobe-07", "category": "Kobe", "english": "Which bakery do you like?", "japanese": "好きなパン屋さんはどこですか？", "romaji": "suki na pan-ya-san wa doko desu ka?", "say": "skee nah pahn-yah-sahn wah doh-koh dess kah", "tip": "Every Kobe local has an answer."},
  {"id": "nara-01", "category": "Nara", "english": "Deer crackers, please", "japanese": "鹿せんべいをください", "romaji": "shika senbei o kudasai", "say": "shee-kah sen-bay oh koo-dah-sigh", "tip": "About ¥200 a bundle."},
  {"id": "nara-02", "category": "Nara", "english": "I don't have any more", "japanese": "もうないよ", "romaji": "mō nai yo", "say": "moh nigh yoh", "tip": "To a deer, with both palms open."},
  {"id": "nara-03", "category": "Nara", "english": "May I request a goshuin?", "japanese": "御朱印をお願いできますか？", "romaji": "goshuin o onegai dekimasu ka?", "say": "go-shoo-een oh oh-neh-guy deh-kee-mass kah", "tip": "Pray first, then ask."},
  {"id": "nara-04", "category": "Nara", "english": "How do I get to Tōdai-ji?", "japanese": "東大寺はどう行けばいいですか？", "romaji": "Tōdai-ji wa dō ikeba ii desu ka?", "say": "toh-dye-jee wah doh ee-keh-bah ee dess kah"},
  {"id": "nara-05", "category": "Nara", "english": "It was delicious", "japanese": "おいしかったです", "romaji": "oishikatta desu", "say": "oy-shee-kaht-tah dess", "tip": "Nara people joke there's nothing tasty here. Prove them wrong."},
  {"id": "nara-06", "category": "Nara", "english": "Do you have bodaimoto sake?", "japanese": "菩提酛のお酒はありますか？", "romaji": "bodaimoto no osake wa arimasu ka?", "say": "boh-dye-moh-toh noh oh-sah-keh wah ah-ree-mass kah", "tip": "The old temple method, revived by local brewers."},
  {"id": "kyoto-01", "category": "Kyoto", "english": "Thank you (Kyoto's favourite)", "japanese": "おおきに", "romaji": "ōkini", "say": "oh-kee-nee"},
  {"id": "kyoto-02", "category": "Kyoto", "english": "Excuse my intrusion", "japanese": "お邪魔します", "romaji": "o-jama shimasu", "say": "oh-jah-mah shee-mass", "tip": "Entering a home, tea room or tiny shop."},
  {"id": "kyoto-03", "category": "Kyoto", "english": "No photography", "japanese": "撮影禁止", "romaji": "satsuei kinshi", "say": "sah-tsoo-ay keen-shee", "tip": "Read it on signs."},
  {"id": "kyoto-04", "category": "Kyoto", "english": "Private road", "japanese": "私道", "romaji": "shidō", "say": "shee-doh", "tip": "Read it on signs in Gion. Fines up to ¥10,000."},
  {"id": "kyoto-05", "category": "Kyoto", "english": "Matcha, please", "japanese": "抹茶をお願いします", "romaji": "matcha o onegai shimasu", "say": "mah-chah oh oh-neh-guy shee-mass"},
  {"id": "kyoto-06", "category": "Kyoto", "english": "I have a reservation", "japanese": "予約しています", "romaji": "yoyaku shite imasu", "say": "yoh-yah-koo shteh ee-mass", "tip": "Add your name before it."},
  {"id": "kyoto-07", "category": "Kyoto", "english": "How beautiful (old Kyoto style)", "japanese": "きれいどすなぁ", "romaji": "kirei dosu nā", "say": "kee-ray doh-soo nah", "tip": "A gentle joke. Say it with a smile."},
  {"id": "kyoto-08", "category": "Kyoto", "english": "Can't be helped", "japanese": "しゃあない", "romaji": "shā nai", "say": "shah nigh", "tip": "The Kansai shrug."},
  {"id": "emergency-01", "category": "Emergency", "english": "Help!", "japanese": "助けて！", "romaji": "Tasukete!", "say": "tah-soo-keh-teh"},
  {"id": "emergency-02", "category": "Emergency", "english": "Where is the hospital?", "japanese": "病院はどこですか？", "romaji": "Byouin wa doko desu ka?", "say": "byoh-een wah doh-koh dess kah"},
  {"id": "emergency-03", "category": "Emergency", "context": "Pharmacy visits", "english": "I have a stomachache.", "japanese": "お腹が痛いです。", "romaji": "Onaka ga itai desu."},
  {"id": "emergency-04", "category": "Emergency", "context": "Lost passport", "english": "I lost my passport.", "japanese": "パスポートをなくしました。", "romaji": "Pasupooto o nakushimashita.", "say": "pah-soo-poh-toh oh nah-koo-shee-mash-tah"},
  {"id": "emergency-05", "category": "Emergency", "context": "Getting lost", "english": "I'm lost. Where is this hotel?", "japanese": "道に迷いました。このホテルはどこですか？", "romaji": "Michi ni mayoimashita. Kono hoteru wa doko desu ka?"},
  {"id": "emergency-06", "category": "Emergency", "context": "Word", "english": "Medicine", "japanese": "薬", "romaji": "Kusuri"},
  {"id": "emergency-07", "category": "Emergency", "context": "Word", "english": "Hospital", "japanese": "病院", "romaji": "Byouin"},
  {"id": "emergency-08", "category": "Emergency", "context": "Word", "english": "Police", "japanese": "警察", "romaji": "Keisatsu"},
  {"id": "emergency-09", "category": "Emergency", "english": "Please call an ambulance", "japanese": "救急車を呼んでください", "romaji": "kyūkyūsha o yonde kudasai", "say": "kyoo-kyoo-shah oh yohn-deh koo-dah-sigh", "tip": "Dial 119 for ambulance or fire, 110 for police."},
  {"id": "emergency-10", "category": "Emergency", "english": "I feel unwell", "japanese": "気分が悪いです", "romaji": "kibun ga warui desu", "say": "kee-boon gah wah-roo-ee dess"}
]
