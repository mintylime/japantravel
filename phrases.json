  { "id": "shopping-01", "category": "Shopping", "english": "How much is this?", "japanese": "これはいくらですか？", "romaji": "Kore wa ikura desu ka?" },
  { "id": "shopping-02", "category": "Shopping", "context": "Bargaining", "english": "Can you make it a little cheaper?", "japanese": "もう少し安くなりますか？", "romaji": "Mou sukoshi yasukunarimasu ka?" },
  { "id": "shopping-03", "category": "Shopping", "english": "Do you take credit cards?", "japanese": "クレジットカードは使えますか？", "romaji": "Kurejitto kaado wa tsukaemasu ka?" },
  { "id": "shopping-04", "category": "Shopping", "context": "Payments", "english": "Can I use Apple Pay?", "japanese": "アップルペイは使えますか？", "romaji": "Appuru pei wa tsukaemasu ka?" },
  { "id": "shopping-05", "category": "Shopping", "context": "Exchanging", "english": "Where can I exchange money?", "japanese": "両替はどこでできますか？", "romaji": "Ryougae wa doko de dekimasu ka?" },
  { "id": "shopping-06", "category": "Shopping", "context": "Finding things", "english": "Where is the ...?", "japanese": "...はどこですか？", "romaji": "... wa doko desu ka?" },
  { "id": "shopping-07", "category": "Shopping", "context": "Finding things", "english": "I'm looking for this. (show a picture)", "japanese": "これを探しています", "romaji": "Kore o sagashite imasu" },
  { "id": "shopping-08", "category": "Shopping", "context": "Finding things", "english": "Could you help me, please?", "japanese": "手伝っていただけますか？", "romaji": "Tetsudatte itadakemasu ka?" },
  { "id": "shopping-09", "category": "Shopping", "context": "Clothes", "english": "May I try it on?", "japanese": "試着してもいいですか？", "romaji": "Shichaku shite mo ii desu ka?" },
  { "id": "shopping-10", "category": "Shopping", "context": "Clothes", "english": "Do you have another size?", "japanese": "ほかのサイズはありますか？", "romaji": "Hoka no saizu wa arimasu ka?" },
  { "id": "shopping-11", "category": "Shopping", "context": "Clothes", "english": "Do you have other colors?", "japanese": "ほかの色はありますか？", "romaji": "Hoka no iro wa arimasu ka?" },
  { "id": "shopping-12", "category": "Shopping", "context": "Payments", "english": "I'll take this, please.", "japanese": "これをください", "romaji": "Kore o kudasai" },
  { "id": "shopping-13", "category": "Shopping", "context": "Payments", "english": "How much is it in total?", "japanese": "全部でいくらですか？", "romaji": "Zenbu de ikura desu ka?" },
  { "id": "shopping-14", "category": "Shopping", "context": "Payments", "english": "Can I pay with cash?", "japanese": "現金でもいいですか？", "romaji": "Genkin demo ii desu ka?" },
